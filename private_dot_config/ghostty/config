# Ghostty Configuration
# Ported from Alacritty & Noctalia theme

# --- Shell ---
command = /usr/bin/fish

# --- Font ---
font-family = "monospace"
font-style = "Medium"
font-size = 14.0

# --- Cursor ---
cursor-style = bar
cursor-style-blink = false
cursor-color = #c1c7ce
cursor-text = #e2e2e5
adjust-cursor-thickness = 8

# --- Window ---
window-padding-x = 2
window-padding-y = 2
background-opacity = 0.9
window-decoration = auto

# --- Scrollback ---
scrollback-limit = 10000

# --- Colors (Noctalia Theme) ---
background = #151e2d
foreground = #f5f2ea
selection-background = #8fcdff
selection-foreground = #111416

# Normal colors
palette = 0=#222527
palette = 1=#ffb4ab
palette = 2=#8ee0a3
palette = 3=#eed48f
palette = 4=#8fcdff
palette = 5=#d0c0e8
palette = 6=#b8c8d9
palette = 7=#e2e2e5

# Bright colors
palette = 8=#585B70
palette = 9=#F38BA8
palette = 10=#A6E3A1
palette = 11=#F9E2AF
palette = 12=#89B4FA
palette = 13=#F5C2E7
palette = 14=#94E2D5
palette = 15=#A6ADC8

# --- Clipboard & Keybindings ---
copy-on-select = true
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection

